{
  "name": "mowzs/system",
  "description": "系统核心模块",
  "type": "happy-module",
  "authors": [
    {
      "name": "sunboy",
      "email": "qysk@vip.qq.com"
    }
  ],
  "require": {
    "php": ">=8.0.0",
    "mowzs/lib": "dev-master"
  },
  "extra": {
    "think": {
      "services": [
        "\\app\\service\\CommonService"
      ]
    },
    "module": {
      "make": {
        "app/admin": "src/admin",
        "app/home": "src/home",
        "app/api": "src/api",
        "app/model": "src/model",
        "app/lang": "src/lang",
        "app/job": "src/job",
        "app/common": "src/common",
        "app/logic": "src/logic",
        "app/common.php": "src/common.php",
        "public/admin.php": "stc/public/admin.php",
        "public/index.php": "stc/public/index.php",
        "public/api.php": "stc/public/api.php",
        ".env.admin": "stc/.env.admin",
        ".env.home": "stc/.env.home",
        ".env.api": "stc/.env.api",
        "app/service/CommonService.php": "src/service/CommonService.php",
        "route/system.php": "stc/route/system.php",
        "extend/think/oauth": "stc/extend/think/oauth"
      },
      "copy": {
        "app/provider.php": "src/provider.php",
        "public/robots.txt": "stc/public/robots.txt",
        "public/router.php": "stc/public/router.php",
        "think": "stc/think"
      },
      "del": true
    }
  }
}
